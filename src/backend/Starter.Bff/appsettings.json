{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc"
  },
  "Bff": { "CookieName": "__Host-starter.bff" },
  "ReverseProxy": {
    "Routes": {
      "sample-api-route": {
        "ClusterId": "sample-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/sample/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/sample" } ]
      }
    },
    "Clusters": {
      "sample-api": {
        "Destinations": {
          "sample-api-destination": { "Address": "https://localhost:7443/" }
        }
      }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
